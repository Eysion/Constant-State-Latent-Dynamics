{
  "name": "constant-state-latent-dynamics",
  "version": "0.1.0",
  "private": true,
  "type": "module",
  "description": "Reproducible Node.js MVP for testing bounded latent drift and state-memory scaling.",
  "keywords": [
    "latent-dynamics",
    "streaming-inference",
    "constant-state",
    "drift-correction",
    "memory-scaling",
    "reproducible-research",
    "nodejs",
    "machine-learning"
  ],
  "repository": {
    "type": "git",
    "url": "git+ssh://git@github.com/Eysion/Constant-State-Latent-Dynamics.git"
  },
  "bugs": {
    "url": "https://github.com/Eysion/Constant-State-Latent-Dynamics/issues"
  },
  "homepage": "https://github.com/Eysion/Constant-State-Latent-Dynamics#readme",
  "license": "PolyForm-Noncommercial-1.0.0",
  "scripts": {
    "build": "rsbuild build",
    "build:web": "rsbuild build --config rsbuild.web.mjs",
    "dev:web": "rsbuild dev --config rsbuild.web.mjs",
    "typecheck": "tsc --noEmit",
    "experiment": "npm run build && node dist/experiment.cjs",
    "discrete": "npm run build && node dist/discrete.cjs",
    "train": "npm run build && node dist/train.cjs",
    "test": "npm run typecheck && npm run build && node --test test/experiment.test.mjs",
    "workflow": "node tooling/ai-workflow/cli/workflow.mjs",
    "workflow:check": "node --test tooling/ai-workflow/test/*.test.mjs"
  },
  "devDependencies": {
    "@rsbuild/core": "^1.7.6",
    "@rsbuild/plugin-react": "^1.4.6",
    "@types/node": "^22.20.2",
    "@types/react": "^19.3.0",
    "@types/react-dom": "^19.3.0",
    "react": "^19.3.0",
    "react-dom": "^19.3.0",
    "typescript": "^5.9.3"
  },
  "engines": {
    "node": ">=20"
  }
}
